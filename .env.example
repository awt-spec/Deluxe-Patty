# Copiar a .env.local. Nunca subir valores reales al repositorio.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dirección pública de la app (para el enlace mágico de entrada), p. ej. https://asistente.ejemplo.com
NEXT_PUBLIC_URL_APP=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# Plantilla de utilidad aprobada por Meta, en español, con un solo parámetro {{1}} en el cuerpo.
# Se usa para escribirle al corredor (escalamientos, avisos) fuera de la ventana de 24 horas.
WHATSAPP_PLANTILLA_AVISO=aviso_corredor
# Plantilla de utilidad para el recordatorio de visita al cliente: {{1}} corredor, {{2}} fecha y hora,
# {{3}} propiedad.
WHATSAPP_PLANTILLA_RECORDATORIO=recordatorio_visita
# Opcional: versión de la Graph API
# WHATSAPP_GRAPH_VERSION=v23.0
# Opcional, solo staging o pruebas locales: servidor que imita la Graph API de Meta.
# WHATSAPP_GRAPH_BASE=

# Demo: correo del usuario de la cuenta de demo (no necesita buzón). Con él aparece "Ver la demo" en
# /entrar. La demo se crea con `npm run demo`.
DEMO_CORREO=

# Vercel Cron: secreto que Vercel manda en Authorization al llamar /api/cron/*
CRON_SECRET=

# Monitoreo: alertas de operación por WhatsApp a soporte (plantilla de aviso).
SOPORTE_WHATSAPP=
SOPORTE_PHONE_NUMBER_ID=
# Alerta si el costo de IA (Claude + imágenes) de un corredor en un día pasa de este monto (USD).
COSTO_DIARIO_ALERTA_USD=3
# Los topes duros de gasto de IA (por día y por mes) ya no van aquí: los define el superadministrador
# en /admin (tabla plataforma y, por corredor, corredores.tope_ia_dia_usd / tope_ia_mes_usd).

# Claude
ANTHROPIC_API_KEY=

# OpenAI (imágenes): mejorar fotos, amueblar cuartos vacíos, quitar objetos e imágenes desde el chat de
# Patty. Sin esta llave esas funciones quedan apagadas (la imagen para redes no la necesita).
OPENAI_API_KEY=
# OPENAI_MODELO_FOTOS=gpt-image-2
# Precios para estimar el gasto (USD por millón de tokens) y el estimado por imagen si la API no informa uso.
# OPENAI_PRECIO_TEXTO_ENTRADA=5
# OPENAI_PRECIO_IMAGEN_ENTRADA=10
# OPENAI_PRECIO_IMAGEN_SALIDA=40
# OPENAI_COSTO_IMAGEN_USD=0.25

# Google (Gmail y Google Calendar del corredor). Proyecto en Google Cloud con la pantalla de permisos y un
# cliente OAuth "Aplicación web" cuya dirección de vuelta es <NEXT_PUBLIC_URL_APP>/api/google/vuelta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes al azar en base64 (openssl rand -base64 32): cifra el permiso de Google en la base.
GOOGLE_TOKEN_KEY=
