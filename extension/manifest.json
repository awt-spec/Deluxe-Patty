{
  "manifest_version": 3,
  "name": "Buscador de dueños",
  "description": "Busca dueños en Encuentra24 a ritmo de persona, llena el formulario de publicar (tú publicas) y te deja hablar con tu asistente.",
  "version": "1.7.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Buscador de dueños"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.encuentra24.com/*",
    "__APP__/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "__APP__/panel/duenos*"
      ],
      "js": [
        "canal.js",
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icono-16.png",
    "48": "icono-48.png",
    "128": "icono-128.png"
  }
}
